# Clave PÚBLICA VAPID (Firebase Console > Project settings > Cloud Messaging > Web Push certificates)
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key_here

# Application Configuration
VITE_APP_NAME=CINCH Interval Staffing
VITE_APP_ENV=development

# SOLO en Vercel (servidor, sin prefijo VITE_): JSON completo de la cuenta de servicio de Firebase
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
